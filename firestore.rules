rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /system_settings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /harmony_notes/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_docs/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_writing/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_music/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_ai_chats/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_calendar/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_transactions/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_accounts/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_budgets/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_loans/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_subscriptions/{document} {
      allow read, write: if isAuthenticated();
    }
  }
}
