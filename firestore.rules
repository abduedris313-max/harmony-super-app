rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /installed_apps/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /app_repositories/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /central_apps_catalog/{appId} {
      // Anyone can browse published mini-apps in the central repository
      allow read: if true;
      // Authenticated users and administrators can publish, update, and manage apps
      allow write: if isAuthenticated();
    }

    match /central_repositories/{repoId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /system_settings/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /admin_users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    match /test/{document=**} {
      allow read: if true;
    }

    match /harmony_notes/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_docs/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_writing/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_music/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_ai_chats/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_calendar/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_transactions/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_accounts/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_budgets/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_loans/{document} {
      allow read, write: if isAuthenticated();
    }

    match /harmony_finance_subscriptions/{document} {
      allow read, write: if isAuthenticated();
    }

    // Harmony Ajam Script rules
    match /manuscripts/{manuscriptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /contributions/{contributionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    match /user_profiles/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
  }
}
