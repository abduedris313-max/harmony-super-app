# ==============================================================================
# Harmony OS Super App - Environment Variables
# Copy this file to `.env` for local development setup.
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Gemini API Key (Server-side only secret, used by Express proxy at /api/gemini)
GEMINI_API_KEY=""

# Hosted Application Base URL
APP_URL="http://localhost:3000"

# Optional: Custom Firebase Client Credentials (Defaults to pre-configured Firestore)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

